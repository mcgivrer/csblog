{
 "version": 1,
 "units": "metres",
 "axes": {
  "forward": "+Z glTF (-Y Blender)",
  "up": "+Y glTF (+Z Blender)"
 },
 "assembly_rule": "place module i so that its SOCKET_FWD coincides with the SOCKET_AFT of module i-1; module origin = its front docking face; offsets below are along the ship forward axis, measured from the ship centre (negative = towards the bow); module_roll_deg = rotation of the module around the ship forward axis (docking rings are round)",
 "runtime_material_rules": {
  "STT_Livery": "companies[company].livery_hex",
  "STT_Livery_Dark": "companies[company].livery_dark_hex",
  "STT_Decals_STT": "swap baseColor texture with companies[company].decals (same atlas layout)",
  "container colour (STT_Container_*)": "container_brands[brand].container_material colour",
  "STT_ContDecals_*": "swap texture with container_brands[brand].decals (same layout)"
 },
